<?xml version="1.0" encoding="utf-8"?>
<!--
  폴더 게시 프로필. 게시가 끝나면 이어서 아래 순서로 업데이트 패키지를 만듭니다.

    게시 → 서명(signtool) → 목록화(update.txt) → 파일별 압축(*.zip)

  Visual Studio 의 게시 버튼과 외부 호출 모두 같은 경로를 탑니다:
    dotnet publish BH_VpnBrowser.csproj -p:PublishProfile=FolderProfile

  외부에서 덮어쓸 수 있는 속성(-p:이름=값):
    UpdatePackageDir             압축·목록 출력 폴더            (기본: <저장소>\Publish\)
    SigningCertificatePath       서명용 PFX                      (기본: D:\BH Soft Cert\cert\BHSoft-CodeSigning.pfx)
    SigningCertificatePassword   PFX 암호. 여기엔 절대 쓰지 않음  (기본: 환경 변수 BHSOFT_CERT_PASSWORD)
    SigningCertificateThumbprint 지정하면 PFX 대신 CurrentUser\My 저장소의 인증서로 서명(암호 불필요)
    SigningTimestampUrl          RFC 3161 타임스탬프 서버         (기본: http://timestamp.digicert.com, 빈 값이면 생략)
    SignToolPath                 signtool.exe 경로               (기본: Windows SDK 에서 최신 버전 자동 탐색)
    SkipSigning                  true 면 서명 생략(개발용). 그래도 목록화·압축은 수행
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- 게시물에 pdb(디버그 심볼)와 패키지 xml(IntelliSense 문서)을 넣지 않습니다. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

    <!-- 업데이트 패키지 설정. 상대 경로는 호출 위치가 아니라 이 프로젝트 기준입니다. -->
    <UpdatePackageDir Condition="'$(UpdatePackageDir)' == ''">$(MSBuildProjectDirectory)\..\Publish\</UpdatePackageDir>
    <SigningCertificatePath Condition="'$(SigningCertificatePath)' == ''">D:\BH Soft Cert\cert\BHSoft-CodeSigning.pfx</SigningCertificatePath>
    <SigningCertificatePassword Condition="'$(SigningCertificatePassword)' == ''">$(BHSOFT_CERT_PASSWORD)</SigningCertificatePassword>
    <SigningTimestampUrl Condition="'$(SigningTimestampUrl)' == ''">http://timestamp.digicert.com</SigningTimestampUrl>
    <SkipSigning Condition="'$(SkipSigning)' == ''">false</SkipSigning>
    <UpdateManifestName Condition="'$(UpdateManifestName)' == ''">update.txt</UpdateManifestName>
  </PropertyGroup>

  <!--
    서명·목록화·압축을 한 태스크에서 처리합니다.
    MSBuild 기본 태스크로는 버전(GetAssemblyIdentity 는 관리 어셈블리만)과 파일별 압축(ZipDirectory 는 폴더만)이
    안 되고, Exec 로 signtool 을 부르면 PFX 암호가 빌드 로그에 남기 때문입니다.
  -->
  <UsingTask TaskName="PackageForUpdate" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PublishDir ParameterType="System.String" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
      <ManifestName ParameterType="System.String" />
      <SkipSigning ParameterType="System.Boolean" />
      <SignToolPath ParameterType="System.String" />
      <CertificatePath ParameterType="System.String" />
      <CertificatePassword ParameterType="System.String" />
      <CertificateThumbprint ParameterType="System.String" />
      <TimestampUrl ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.IO.Compression;
using System.Linq;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class PackageForUpdate : Task
{
    [Required] public string PublishDir { get; set; }
    [Required] public string OutputDir { get; set; }
    public string ManifestName { get; set; }
    public bool SkipSigning { get; set; }
    public string SignToolPath { get; set; }
    public string CertificatePath { get; set; }
    public string CertificatePassword { get; set; }
    public string CertificateThumbprint { get; set; }
    public string TimestampUrl { get; set; }

    private string _publishDir;
    private string _outputDir;

    public override bool Execute()
    {
        try
        {
            _publishDir = WithTrailingSlash(Path.GetFullPath(PublishDir));
            _outputDir = WithTrailingSlash(Path.GetFullPath(OutputDir));
            var manifestName = string.IsNullOrWhiteSpace(ManifestName) ? "update.txt" : ManifestName;

            if (!Directory.Exists(_publishDir))
            {
                Log.LogError("게시 폴더가 없습니다: {0}", _publishDir);
                return false;
            }

            var files = Directory.GetFiles(_publishDir, "*", SearchOption.AllDirectories)
                .Where(f => !string.Equals(Path.GetFileName(f), manifestName, StringComparison.OrdinalIgnoreCase))
                .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (files.Count == 0)
            {
                Log.LogError("게시 폴더가 비어 있습니다: {0}", _publishDir);
                return false;
            }

            // 1. 서명 — 해시는 서명된 바이트 기준이어야 하므로 목록화보다 먼저 합니다.
            if (SkipSigning)
            {
                Log.LogWarning("SkipSigning=true: 서명을 건너뜁니다. 배포용 패키지에는 쓰지 마세요.");
            }
            else if (!SignAll(files))
            {
                return false;
            }

            // 2. 목록화 — 파일명 / SHA-256 / 파일 버전 / 크기(바이트), 탭 구분, 한 줄에 하나.
            Directory.CreateDirectory(_outputDir);
            CleanOutput(manifestName);

            var lines = new List<string>();
            foreach (var file in files)
            {
                lines.Add(string.Join("\t", Relative(file), Sha256(file), VersionOf(file), new FileInfo(file).Length.ToString()));
            }

            var manifestPath = Path.Combine(_outputDir, manifestName);
            File.WriteAllText(manifestPath, string.Join("\r\n", lines) + "\r\n", new UTF8Encoding(false));

            // 3. 압축 — 폴더 구조를 유지하며 파일마다 <이름>.zip 하나씩. 항목 이름은 파일명만 두어 풀면 원본이 됩니다.
            foreach (var file in files)
            {
                var zipPath = Path.Combine(_outputDir, Relative(file) + ".zip");
                Directory.CreateDirectory(Path.GetDirectoryName(zipPath));

                using (var zip = ZipFile.Open(zipPath, ZipArchiveMode.Create))
                {
                    zip.CreateEntryFromFile(file, Path.GetFileName(file), CompressionLevel.Optimal);
                }
            }

            Log.LogMessage(MessageImportance.High, "업데이트 패키지: {0}개 파일 → {1} ({2})", files.Count, _outputDir, manifestName);
            return true;
        }
        catch (Exception ex)
        {
            Log.LogErrorFromException(ex, false);
            return false;
        }
    }

    /// <summary>서명이 없는 exe/dll 만 서명합니다. 이미 서명된 파일(WebView2 등 Microsoft 서명)은 그대로 둡니다.</summary>
    private bool SignAll(List<string> files)
    {
        var targets = files
            .Where(f => { var e = Path.GetExtension(f).ToLowerInvariant(); return e == ".exe" || e == ".dll"; })
            .Where(f => !HasSignature(f))
            .ToList();

        if (targets.Count == 0)
        {
            Log.LogMessage(MessageImportance.High, "서명할 파일이 없습니다(모두 서명됨).");
            return true;
        }

        var signTool = ResolveSignTool();
        if (signTool == null)
        {
            Log.LogError("signtool.exe 를 찾지 못했습니다. Windows SDK 를 설치하거나 SignToolPath 를 지정하세요.");
            return false;
        }

        var common = new StringBuilder("sign /fd SHA256");
        if (!string.IsNullOrWhiteSpace(TimestampUrl))
        {
            common.Append(" /tr \"").Append(TimestampUrl).Append("\" /td SHA256");
        }

        if (!string.IsNullOrWhiteSpace(CertificateThumbprint))
        {
            common.Append(" /sha1 ").Append(CertificateThumbprint.Trim());
        }
        else
        {
            if (string.IsNullOrWhiteSpace(CertificatePath) || !File.Exists(CertificatePath))
            {
                Log.LogError("서명 인증서(PFX)가 없습니다: {0}  (SkipSigning=true 로 건너뛸 수 있습니다)", CertificatePath);
                return false;
            }

            common.Append(" /f \"").Append(CertificatePath).Append("\"");
            if (!string.IsNullOrEmpty(CertificatePassword))
            {
                common.Append(" /p \"").Append(CertificatePassword).Append("\"");
            }
        }

        foreach (var file in targets)
        {
            var info = new ProcessStartInfo(signTool, common + " \"" + file + "\"")
            {
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true,
            };

            using (var process = Process.Start(info))
            {
                var output = process.StandardOutput.ReadToEnd();
                var error = process.StandardError.ReadToEnd();
                process.WaitForExit();

                if (process.ExitCode != 0)
                {
                    // 명령줄은 암호가 들어 있을 수 있어 로그에 남기지 않습니다.
                    var detail = (error + "\n" + output).Trim();
                    var hint = string.IsNullOrEmpty(CertificatePassword) && string.IsNullOrWhiteSpace(CertificateThumbprint)
                        ? "\nPFX 에 암호가 걸려 있으면 환경 변수 BHSOFT_CERT_PASSWORD 또는 -p:SigningCertificatePassword=... 로 넘기거나, " +
                          "인증서가 CurrentUser\\My 에 있으면 -p:SigningCertificateThumbprint=... 를 쓰세요."
                        : string.Empty;
                    Log.LogError("서명 실패 ({0}): {1}{2}", Relative(file), detail, hint);
                    return false;
                }
            }

            Log.LogMessage(MessageImportance.High, "서명: {0}", Relative(file));
        }

        return true;
    }

    private static bool HasSignature(string path)
    {
        try
        {
            X509Certificate.CreateFromSignedFile(path);
            return true;
        }
        catch (CryptographicException)
        {
            return false;
        }
    }

    /// <summary>Windows SDK 의 x64 signtool 중 가장 높은 버전을 고릅니다.</summary>
    private string ResolveSignTool()
    {
        if (!string.IsNullOrWhiteSpace(SignToolPath) && File.Exists(SignToolPath))
        {
            return SignToolPath;
        }

        var programFiles = Environment.GetEnvironmentVariable("ProgramFiles(x86)") ?? Environment.GetEnvironmentVariable("ProgramFiles");
        if (string.IsNullOrEmpty(programFiles))
        {
            return null;
        }

        var binRoot = Path.Combine(programFiles, "Windows Kits", "10", "bin");
        if (Directory.Exists(binRoot))
        {
            var candidates = Directory.GetDirectories(binRoot)
                .Select(d => new { Dir = d, Version = ParseVersion(Path.GetFileName(d)) })
                .Where(x => x.Version != null)
                .OrderByDescending(x => x.Version)
                .Select(x => Path.Combine(x.Dir, "x64", "signtool.exe"))
                .Where(File.Exists)
                .ToList();

            if (candidates.Count > 0)
            {
                return candidates[0];
            }
        }

        var fallback = Path.Combine(programFiles, "Windows Kits", "10", "App Certification Kit", "signtool.exe");
        return File.Exists(fallback) ? fallback : null;
    }

    private static Version ParseVersion(string text)
    {
        Version version;
        return Version.TryParse(text, out version) ? version : null;
    }

    /// <summary>이전 패키지의 zip 과 목록만 지웁니다. 같은 폴더의 다른 파일(index.html 등)은 건드리지 않습니다.</summary>
    private void CleanOutput(string manifestName)
    {
        foreach (var zip in Directory.GetFiles(_outputDir, "*.zip", SearchOption.AllDirectories))
        {
            File.Delete(zip);
        }

        var manifest = Path.Combine(_outputDir, manifestName);
        if (File.Exists(manifest))
        {
            File.Delete(manifest);
        }

        foreach (var dir in Directory.GetDirectories(_outputDir, "*", SearchOption.AllDirectories).OrderByDescending(d => d.Length))
        {
            if (!Directory.EnumerateFileSystemEntries(dir).Any())
            {
                Directory.Delete(dir);
            }
        }
    }

    private string Relative(string file) => file.Substring(_publishDir.Length);

    private static string Sha256(string file)
    {
        using (var sha = SHA256.Create())
        using (var stream = File.OpenRead(file))
        {
            return BitConverter.ToString(sha.ComputeHash(stream)).Replace("-", string.Empty).ToLowerInvariant();
        }
    }

    /// <summary>PE 파일의 FileVersion. 버전 정보가 없는 파일(json 등)은 빈 칸입니다.</summary>
    private static string VersionOf(string file)
    {
        try
        {
            var version = FileVersionInfo.GetVersionInfo(file).FileVersion;
            return string.IsNullOrWhiteSpace(version) ? string.Empty : version.Trim();
        }
        catch (Exception)
        {
            return string.Empty;
        }
    }

    private static string WithTrailingSlash(string path) =>
        path.EndsWith("\\") || path.EndsWith("/") ? path : path + "\\";
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PackagePublishedFilesForUpdate" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PackageForUpdate
      PublishDir="$(PublishDir)"
      OutputDir="$(UpdatePackageDir)"
      ManifestName="$(UpdateManifestName)"
      SkipSigning="$(SkipSigning)"
      SignToolPath="$(SignToolPath)"
      CertificatePath="$(SigningCertificatePath)"
      CertificatePassword="$(SigningCertificatePassword)"
      CertificateThumbprint="$(SigningCertificateThumbprint)"
      TimestampUrl="$(SigningTimestampUrl)" />
  </Target>
</Project>
