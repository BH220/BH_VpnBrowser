<Window x:Class="BH_VpnBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BH_VpnBrowser.ViewModels"
        mc:Ignorable="d"
        Title="BH VPN Browser" Height="820" Width="1280" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/Assets/AppIcon.png"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <!-- 기본 캡션을 숨기고 타이틀바를 직접 그립니다. CaptionHeight 만큼이 드래그 영역이 됩니다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 주소창 오른쪽 끝에 얹는 확대/축소 표시 -->
        <Style x:Key="ZoomChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다운로드 목록 항목 -->
        <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type vm:DownloadItem}">
            <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="11,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallIconButton}"
                                    ToolTip="폴더에서 보기" Click="DownloadShowInFolder_Click"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                <Path Style="{StaticResource SmallIconPath}"
                                      Data="M 22,19 A 2,2 0 0 1 20,21 L 4,21 A 2,2 0 0 1 2,19 L 2,5 A 2,2 0 0 1 4,3 L 9,3 L 11,6 L 20,6 A 2,2 0 0 1 22,8 Z" />
                            </Button>
                            <Button Style="{StaticResource SmallIconButton}" Margin="3,0,0,0"
                                    ToolTip="다운로드 취소" Click="DownloadCancel_Click"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                <Path Style="{StaticResource SmallIconPath}" Data="M 18,6 L 6,18 M 6,6 L 18,18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Cursor="Hand"
                                   VerticalAlignment="Center" MouseLeftButtonUp="DownloadOpen_Click"
                                   ToolTip="{Binding FullPath}" />
                    </DockPanel>

                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2" Text="{Binding StateText}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootPanel">

        <!-- ============ 타이틀바 (아이콘 + 탭 + 새 탭 + 창 버튼) ============ -->
        <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <!-- 앱 아이콘: 벡터라 어떤 DPI 에서도 선명합니다 (작업표시줄용은 Assets/AppIcon.ico) -->
                <Border DockPanel.Dock="Left" Width="42" Background="Transparent">
                    <Path Data="{StaticResource AppLogoGeometry}" Fill="{StaticResource AppLogoBrush}"
                          Stretch="Uniform" Width="21" Height="21" />
                </Border>

                <!-- 창 버튼 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" ToolTip="최소화" Click="MinimizeButton_Click">
                        <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,0" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            ToolTip="최대화" Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}"
                              Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" ToolTip="닫기" Click="CloseButton_Click">
                        <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>

                <!-- 탭 + 새 탭 버튼 (남는 공간은 창 드래그 영역) -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Bottom" Background="Transparent">
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl x:Name="TabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrowserTab}">
                                    <Border x:Name="TabRoot" Height="33" MinWidth="140" MaxWidth="230"
                                            CornerRadius="8,8,0,0" Background="Transparent" Margin="0,0,2,0"
                                            Cursor="Hand" MouseDown="Tab_MouseDown" ToolTip="{Binding Address}">
                                            <DockPanel Margin="12,0,7,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}"
                                                        VerticalAlignment="Center" Click="TabCloseButton_Click"
                                                        ToolTip="탭 닫기 (Ctrl+W)" />
                                                <Ellipse x:Name="LoadingDot" DockPanel.Dock="Left" Width="7" Height="7"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                                <TextBlock x:Name="TabTitle" Text="{Binding Title}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" FontSize="12.5"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </DockPanel>
                                        </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter TargetName="LoadingDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 새 탭 버튼: 마지막 탭 바로 옆 -->
                        <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="3,0,0,3"
                                VerticalAlignment="Bottom" ToolTip="새 탭 (Ctrl+T)" Click="NewTabButton_Click">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Data="M 12,5 L 12,19 M 5,12 L 19,12" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ================= 툴바 ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceRaisedBrush}" Padding="8,7">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" ToolTip="뒤로 (Alt+←)"
                            Click="BackButton_Click" IsEnabled="False">
                        <Path Style="{StaticResource IconPath}" Data="M 15,4 L 7,12 L 15,20" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" ToolTip="앞으로 (Alt+→)"
                            Click="ForwardButton_Click" IsEnabled="False">
                        <Path Style="{StaticResource IconPath}" Data="M 9,4 L 17,12 L 9,20" />
                    </Button>
                    <!-- 로딩 중에는 중단(X), 완료되면 새로고침으로 바뀝니다 -->
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolButton}" ToolTip="새로고침 (F5)"
                            Click="ReloadButton_Click">
                        <Path x:Name="ReloadGlyph" Style="{StaticResource IconPath}"
                              Data="M 20.5,15 A 9,9 0 1 1 18.4,5.6 L 23,10 M 23,4 L 23,10 L 17,10" />
                    </Button>
                    <Button x:Name="HomeButton" Style="{StaticResource ToolButton}" ToolTip="홈"
                            Click="HomeButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M 3,9 L 12,2 L 21,9 L 21,20 A 2,2 0 0 1 19,22 L 5,22 A 2,2 0 0 1 3,20 Z M 9,22 L 9,13 L 15,13 L 15,22" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Grid Margin="0,0,2,0">
                        <Button x:Name="DownloadsButton" Style="{StaticResource ToolButton}"
                                ToolTip="다운로드 (Ctrl+J)" Click="DownloadsButton_Click">
                            <Path Style="{StaticResource IconPath}"
                                  Data="M 3,15 L 3,19 A 2,2 0 0 0 5,21 L 19,21 A 2,2 0 0 0 21,19 L 21,15 M 7,10 L 12,15 L 17,10 M 12,15 L 12,3" />
                        </Button>
                        <Border x:Name="DownloadsBadge" Width="15" Height="15" CornerRadius="7.5"
                                Background="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="DownloadsBadgeText" Text="0" FontSize="9" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}"
                               Placement="Bottom" HorizontalOffset="-330" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Width="380" Padding="12" Margin="0,0,10,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel Margin="2,0,2,10">
                                        <Button DockPanel.Dock="Right" Content="목록 지우기"
                                                Style="{StaticResource SubtleButton}" Height="26" FontSize="11"
                                                Padding="9,0" Click="ClearDownloads_Click" />
                                        <TextBlock Text="다운로드" FontSize="13.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock x:Name="NoDownloadsText" Text="아직 받은 파일이 없습니다."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               Margin="2,10,2,14" />

                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DownloadsList"
                                                      ItemTemplate="{StaticResource DownloadItemTemplate}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 햄버거 메뉴: 인쇄 / IP 확인 / VPN 설정 -->
                    <Grid>
                        <Button x:Name="MenuButton" Style="{StaticResource ToolButton}" ToolTip="메뉴"
                                Click="MenuButton_Click">
                            <Path Style="{StaticResource IconPath}"
                                  Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" />
                        </Button>

                        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}"
                               Placement="Bottom" HorizontalOffset="-186" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Width="230" Padding="6" Margin="0,0,10,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource MenuItemButton}" Click="PrintButton_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+P" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <Path Style="{StaticResource IconPath}" Width="14" Height="14"
                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Data="M 6,9 L 6,2 L 18,2 L 18,9 M 6,18 L 4,18 A 2,2 0 0 1 2,16 L 2,11 A 2,2 0 0 1 4,9 L 20,9 A 2,2 0 0 1 22,11 L 22,16 A 2,2 0 0 1 20,18 L 18,18 M 6,14 L 18,14 L 18,22 L 6,22 Z" />
                                            <TextBlock Text="인쇄" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>

                                    <Button Style="{StaticResource MenuItemButton}" Click="IpCheckButton_Click"
                                            ToolTip="이 브라우저가 실제로 사용하는 외부 IP 확인"
                                            AutomationProperties.Name="현재 외부 IP 확인">
                                        <DockPanel>
                                            <Path Style="{StaticResource IconPath}" Width="14" Height="14"
                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 A 14,14 0 0 1 12,22 A 14,14 0 0 1 12,2 Z" />
                                            <TextBlock Text="현재 외부 IP 확인" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>

                                    <Separator Margin="6,5" Background="{StaticResource BorderBrush}" Height="1" />

                                    <Button Style="{StaticResource MenuItemButton}" Click="SettingsButton_Click">
                                        <DockPanel>
                                            <Path Style="{StaticResource IconPath}" Width="14" Height="14"
                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Data="M 12,2 L 20,5.5 V 12 C 20,17 16.5,20.5 12,22 C 7.5,20.5 4,17 4,12 V 5.5 Z" />
                                            <TextBlock Text="VPN 설정" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- 주소창. 오른쪽 끝(크롬과 같은 자리)에 확대/축소 표시를 겹쳐 둡니다. -->
                <Grid>
                    <TextBox x:Name="AddressBox" KeyDown="AddressBox_KeyDown"
                             GotKeyboardFocus="AddressBox_GotKeyboardFocus" Padding="10,0,78,0" />

                    <Button x:Name="ZoomButton" Style="{StaticResource ZoomChip}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                            Click="ZoomButton_Click" ToolTip="확대/축소 (Ctrl + 마우스 휠)"
                            AutomationProperties.Name="확대/축소">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SmallIconPath}"
                                  Data="M 10,3 A 7,7 0 1 1 3,10 A 7,7 0 0 1 10,3 M 15,15 L 20,20 M 7,10 L 13,10" />
                            <TextBlock x:Name="ZoomText" Text="100%" Margin="5,0,0,0"
                                       VerticalAlignment="Center" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomButton}"
                           Placement="Bottom" HorizontalOffset="-150" VerticalOffset="8"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="확대/축소" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,12,0" />
                                <Button Style="{StaticResource SubtleButton}" Width="32" Height="28"
                                        Content="−" FontSize="15" Click="ZoomOutButton_Click" ToolTip="축소 (Ctrl+-)"
                                        AutomationProperties.Name="축소" />
                                <TextBlock x:Name="ZoomPopupText" Text="100%" Width="56" TextAlignment="Center"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" />
                                <Button Style="{StaticResource SubtleButton}" Width="32" Height="28"
                                        Content="+" FontSize="15" Click="ZoomInButton_Click" ToolTip="확대 (Ctrl++)"
                                        AutomationProperties.Name="확대" />
                                <Button Style="{StaticResource SubtleButton}" Content="재설정" Height="28"
                                        FontSize="12" Margin="10,0,0,0" Click="ZoomResetButton_Click"
                                        ToolTip="100% 로 되돌리기 (Ctrl+0)"
                                        AutomationProperties.Name="확대축소 재설정" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= 상태바 ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <Border x:Name="ProxyBadge" DockPanel.Dock="Left" CornerRadius="4" Padding="9,3" Margin="0,0,12,0"
                        Background="{StaticResource DangerBrush}">
                    <TextBlock x:Name="ProxyBadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                               Text="직결 (VPN 미적용)" />
                </Border>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" Text="준비" />
            </DockPanel>
        </Border>

        <!-- ========= 브라우저 영역: 탭별 WebView2 를 겹쳐 두고 선택된 것만 표시 ========= -->
        <Grid x:Name="BrowserHost" Background="{StaticResource SurfaceSunkenBrush}" />
    </DockPanel>
</Window>
