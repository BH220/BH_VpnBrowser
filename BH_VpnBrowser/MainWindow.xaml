<Window
    x:Class="BH_VpnBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_VpnBrowser.ViewModels"
    Title="BH VPN Browser"
    Width="1280"
    Height="820"
    MinWidth="820"
    MinHeight="480"
    Background="{StaticResource SurfaceBrush}"
    Icon="/Assets/AppIcon.png"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="CanResize"
    StateChanged="Window_StateChanged"
    TextOptions.TextFormattingMode="Ideal"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--  기본 캡션을 숨기고 타이틀바를 직접 그립니다. CaptionHeight 만큼이 드래그 영역이 됩니다.  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  주소창 오른쪽 끝에 얹는 확대/축소 표시  -->
        <Style x:Key="ZoomChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  다운로드 목록 항목  -->
        <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type vm:DownloadItem}">
            <Border
                Margin="0,0,0,6"
                Padding="11,9"
                Background="{StaticResource SurfaceSunkenBrush}"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button
                                Click="DownloadShowInFolder_Click"
                                Style="{StaticResource SmallIconButton}"
                                ToolTip="폴더에서 보기"
                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="M 22,19 A 2,2 0 0 1 20,21 L 4,21 A 2,2 0 0 1 2,19 L 2,5 A 2,2 0 0 1 4,3 L 9,3 L 11,6 L 20,6 A 2,2 0 0 1 22,8 Z" Style="{StaticResource SmallIconPath}" />
                            </Button>
                            <Button
                                Margin="3,0,0,0"
                                Click="DownloadCancel_Click"
                                Style="{StaticResource SmallIconButton}"
                                ToolTip="다운로드 취소"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="M 18,6 L 6,18 M 6,6 L 18,18" Style="{StaticResource SmallIconPath}" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            MouseLeftButtonUp="DownloadOpen_Click"
                            Text="{Binding FileName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FullPath}" />
                    </DockPanel>

                    <ProgressBar
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Maximum="100"
                        Value="{Binding Progress, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootPanel">

        <!--  ============ 타이틀바 (아이콘 + 탭 + 새 탭 + 창 버튼) ============  -->
        <Grid
            Height="40"
            Background="{StaticResource SurfaceBrush}"
            DockPanel.Dock="Top">
            <DockPanel>
                <!--  앱 아이콘: 벡터라 어떤 DPI 에서도 선명합니다 (작업표시줄용은 Assets/AppIcon.ico)  -->
                <Border
                    Width="42"
                    Background="Transparent"
                    DockPanel.Dock="Left">
                    <Path
                        Width="21"
                        Height="21"
                        Data="{StaticResource AppLogoGeometry}"
                        Fill="{StaticResource AppLogoBrush}"
                        Stretch="Uniform" />
                </Border>

                <!--  창 버튼  -->
                <StackPanel
                    VerticalAlignment="Top"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="MinimizeButton_Click"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="최소화">
                        <Path Data="M 0,0 L 10,0" Style="{StaticResource CaptionGlyph}" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="최대화">
                        <Path
                            x:Name="MaximizeGlyph"
                            Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                            Style="{StaticResource CaptionGlyph}" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource CaptionCloseButton}"
                        ToolTip="닫기">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Style="{StaticResource CaptionGlyph}" />
                    </Button>
                </StackPanel>

                <!--  탭 + 새 탭 버튼 (남는 공간은 창 드래그 영역)  -->
                <ScrollViewer
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl x:Name="TabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrowserTab}">
                                    <Border
                                        x:Name="TabRoot"
                                        Height="33"
                                        MinWidth="140"
                                        MaxWidth="230"
                                        Margin="0,0,2,0"
                                        Background="Transparent"
                                        CornerRadius="8,8,0,0"
                                        Cursor="Hand"
                                        MouseDown="Tab_MouseDown"
                                        ToolTip="{Binding Address}">
                                        <DockPanel Margin="12,0,7,0">
                                            <Button
                                                VerticalAlignment="Center"
                                                Click="TabCloseButton_Click"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource TabCloseButton}"
                                                ToolTip="탭 닫기 (Ctrl+W)" />
                                            <Ellipse
                                                x:Name="LoadingDot"
                                                Width="7"
                                                Height="7"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Fill="{StaticResource AccentBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="TabTitle"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter TargetName="LoadingDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  새 탭 버튼: 마지막 탭 바로 옆  -->
                        <Button
                            Width="30"
                            Height="30"
                            Margin="3,0,0,3"
                            VerticalAlignment="Bottom"
                            Click="NewTabButton_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTip="새 탭 (Ctrl+T)">
                            <Path
                                Width="13"
                                Height="13"
                                Data="M 12,5 L 12,19 M 5,12 L 19,12"
                                Style="{StaticResource IconPath}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!--  ================= 툴바 =================  -->
        <Border
            Padding="8,7"
            Background="{StaticResource SurfaceRaisedBrush}"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel
                    Margin="0,0,8,0"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BackButton"
                        Click="BackButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource ToolButton}"
                        ToolTip="뒤로 (Alt+←)">
                        <Path Data="M 15,4 L 7,12 L 15,20" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Click="ForwardButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource ToolButton}"
                        ToolTip="앞으로 (Alt+→)">
                        <Path Data="M 9,4 L 17,12 L 9,20" Style="{StaticResource IconPath}" />
                    </Button>
                    <!--  로딩 중에는 중단(X), 완료되면 새로고침으로 바뀝니다  -->
                    <Button
                        x:Name="ReloadButton"
                        Click="ReloadButton_Click"
                        Style="{StaticResource ToolButton}"
                        ToolTip="새로고침 (F5)">
                        <Path
                            x:Name="ReloadGlyph"
                            Data="M 20.5,15 A 9,9 0 1 1 18.4,5.6 L 23,10 M 23,4 L 23,10 L 17,10"
                            Style="{StaticResource IconPath}" />
                    </Button>
                    <Button
                        x:Name="HomeButton"
                        Click="HomeButton_Click"
                        Style="{StaticResource ToolButton}"
                        ToolTip="홈">
                        <Path Data="M 3,9 L 12,2 L 21,9 L 21,20 A 2,2 0 0 1 19,22 L 5,22 A 2,2 0 0 1 3,20 Z M 9,22 L 9,13 L 15,13 L 15,22" Style="{StaticResource IconPath}" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Margin="8,0,0,0"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Grid Margin="0,0,2,0">
                        <Button
                            x:Name="DownloadsButton"
                            Click="DownloadsButton_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTip="다운로드 (Ctrl+J)">
                            <Path Data="M 3,15 L 3,19 A 2,2 0 0 0 5,21 L 19,21 A 2,2 0 0 0 21,19 L 21,15 M 7,10 L 12,15 L 17,10 M 12,15 L 12,3" Style="{StaticResource IconPath}" />
                        </Button>
                        <Border
                            x:Name="DownloadsBadge"
                            Width="15"
                            Height="15"
                            Margin="0,-1,-1,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="7.5"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="DownloadsBadgeText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="0" />
                        </Border>

                        <Popup
                            x:Name="DownloadsPopup"
                            AllowsTransparency="True"
                            HorizontalOffset="-330"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=DownloadsButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            VerticalOffset="6">
                            <Border
                                Width="380"
                                Margin="0,0,10,10"
                                Padding="12"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="18"
                                        Opacity="0.55"
                                        ShadowDepth="3"
                                        Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel Margin="2,0,2,10">
                                        <Button
                                            Height="26"
                                            Padding="9,0"
                                            Click="ClearDownloads_Click"
                                            Content="목록 지우기"
                                            DockPanel.Dock="Right"
                                            FontSize="11"
                                            Style="{StaticResource SubtleButton}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Text="다운로드" />
                                    </DockPanel>

                                    <TextBlock
                                        x:Name="NoDownloadsText"
                                        Margin="2,10,2,14"
                                        FontSize="12"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="아직 받은 파일이 없습니다." />

                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DownloadsList" ItemTemplate="{StaticResource DownloadItemTemplate}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!--  햄버거 메뉴: 인쇄 / IP 확인 / VPN 설정  -->
                    <Grid>
                        <Button
                            x:Name="MenuButton"
                            Click="MenuButton_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTip="메뉴">
                            <Path Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" Style="{StaticResource IconPath}" />
                        </Button>

                        <Popup
                            x:Name="MenuPopup"
                            AllowsTransparency="True"
                            HorizontalOffset="-186"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=MenuButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            VerticalOffset="6">
                            <Border
                                Width="230"
                                Margin="0,0,10,10"
                                Padding="6"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="18"
                                        Opacity="0.55"
                                        ShadowDepth="3"
                                        Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Click="PrintButton_Click" Style="{StaticResource MenuItemButton}">
                                        <DockPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                FontSize="11"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="Ctrl+P" />
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Data="M 6,9 L 6,2 L 18,2 L 18,9 M 6,18 L 4,18 A 2,2 0 0 1 2,16 L 2,11 A 2,2 0 0 1 4,9 L 20,9 A 2,2 0 0 1 22,11 L 22,16 A 2,2 0 0 1 20,18 L 18,18 M 6,14 L 18,14 L 18,22 L 6,22 Z"
                                                Style="{StaticResource IconPath}" />
                                            <TextBlock VerticalAlignment="Center" Text="인쇄" />
                                        </DockPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="현재 외부 IP 확인"
                                        Click="IpCheckButton_Click"
                                        Style="{StaticResource MenuItemButton}"
                                        ToolTip="이 브라우저가 실제로 사용하는 외부 IP 확인">
                                        <DockPanel>
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 A 14,14 0 0 1 12,22 A 14,14 0 0 1 12,2 Z"
                                                Style="{StaticResource IconPath}" />
                                            <TextBlock VerticalAlignment="Center" Text="현재 외부 IP 확인" />
                                        </DockPanel>
                                    </Button>

                                    <Separator
                                        Height="1"
                                        Margin="6,5"
                                        Background="{StaticResource BorderBrush}" />

                                    <Button Click="SettingsButton_Click" Style="{StaticResource MenuItemButton}">
                                        <DockPanel>
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Data="M 12,2 L 20,5.5 V 12 C 20,17 16.5,20.5 12,22 C 7.5,20.5 4,17 4,12 V 5.5 Z"
                                                Style="{StaticResource IconPath}" />
                                            <TextBlock VerticalAlignment="Center" Text="VPN 설정" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!--  주소창. 오른쪽 끝(크롬과 같은 자리)에 확대/축소 표시를 겹쳐 둡니다.  -->
                <Grid>
                    <TextBox
                        x:Name="AddressBox"
                        Padding="10,0,78,0"
                        GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                        KeyDown="AddressBox_KeyDown" />

                    <Button
                        x:Name="ZoomButton"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="확대/축소"
                        Click="ZoomButton_Click"
                        Style="{StaticResource ZoomChip}"
                        ToolTip="확대/축소 (Ctrl + 마우스 휠)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 10,3 A 7,7 0 1 1 3,10 A 7,7 0 0 1 10,3 M 15,15 L 20,20 M 7,10 L 13,10" Style="{StaticResource SmallIconPath}" />
                            <TextBlock
                                x:Name="ZoomText"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Text="100%" />
                        </StackPanel>
                    </Button>

                    <Popup
                        x:Name="ZoomPopup"
                        AllowsTransparency="True"
                        HorizontalOffset="-150"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ZoomButton}"
                        PopupAnimation="Fade"
                        StaysOpen="False"
                        VerticalOffset="8">
                        <Border
                            Margin="0,0,10,10"
                            Padding="12,10"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="18"
                                    Opacity="0.55"
                                    ShadowDepth="3"
                                    Color="Black" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="2,0,12,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="확대/축소" />
                                <Button
                                    Width="32"
                                    Height="28"
                                    AutomationProperties.Name="축소"
                                    Click="ZoomOutButton_Click"
                                    Content="−"
                                    FontSize="15"
                                    Style="{StaticResource SubtleButton}"
                                    ToolTip="축소 (Ctrl+-)" />
                                <TextBlock
                                    x:Name="ZoomPopupText"
                                    Width="56"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource TextBrush}"
                                    Text="100%"
                                    TextAlignment="Center" />
                                <Button
                                    Width="32"
                                    Height="28"
                                    AutomationProperties.Name="확대"
                                    Click="ZoomInButton_Click"
                                    Content="+"
                                    FontSize="15"
                                    Style="{StaticResource SubtleButton}"
                                    ToolTip="확대 (Ctrl++)" />
                                <Button
                                    Height="28"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="확대축소 재설정"
                                    Click="ZoomResetButton_Click"
                                    Content="재설정"
                                    FontSize="12"
                                    Style="{StaticResource SubtleButton}"
                                    ToolTip="100% 로 되돌리기 (Ctrl+0)" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!--  ================= 상태바 =================  -->
        <Border
            Padding="10,5"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <Border
                    x:Name="ProxyBadge"
                    Margin="0,0,12,0"
                    Padding="9,3"
                    Background="{StaticResource DangerBrush}"
                    CornerRadius="4"
                    DockPanel.Dock="Left">
                    <TextBlock
                        x:Name="ProxyBadgeText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="직결 (VPN 미적용)" />
                </Border>
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="준비"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!--  ========= 브라우저 영역: 탭별 WebView2 를 겹쳐 두고 선택된 것만 표시 =========  -->
        <Grid x:Name="BrowserHost" Background="{StaticResource SurfaceSunkenBrush}" />
    </DockPanel>
</Window>
