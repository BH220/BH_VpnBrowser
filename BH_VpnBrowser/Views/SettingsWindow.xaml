<Window
    x:Class="BH_VpnBrowser.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_VpnBrowser.ViewModels"
    Title="VPN 설정"
    Width="480"
    Height="790"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    Background="{StaticResource SurfaceBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Ideal"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
            <TextBlock
                Margin="0,0,0,6"
                FontSize="12.5"
                FontWeight="SemiBold"
                Text="서버 주소" />
            <TextBox Margin="0,0,0,16" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12.5"
                FontWeight="SemiBold"
                Text="사용자 이름" />
            <TextBox Margin="0,0,0,16" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12.5"
                FontWeight="SemiBold"
                Text="비밀번호" />
            <!--  PasswordBox 는 보안상 Password 를 바인딩할 수 없어 코드 비하인드에서 ViewModel 로 옮겨 줍니다.  -->
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12.5"
                FontWeight="SemiBold"
                Text="IPsec 사전 공유 키 (서버가 요구하는 경우에만)" />
            <PasswordBox x:Name="PskBox" Margin="0,0,0,18" />

            <CheckBox
                Margin="0,0,0,10"
                Content="앱 시작 시 VPN 이 끊겨 있으면 자동 연결"
                IsChecked="{Binding AutoConnect}" />
            <CheckBox
                Margin="0,0,0,10"
                Content="WebRTC 를 통한 실제 IP 노출 차단"
                IsChecked="{Binding BlockWebRtcLeak}" />
            <CheckBox
                Margin="0,0,0,18"
                Content="사설/로컬 주소는 터널을 거치지 않음"
                IsChecked="{Binding BypassLoopback}" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12.5"
                FontWeight="SemiBold"
                Text="시작 페이지" />
            <TextBox Margin="0,0,0,18" Text="{Binding HomePage, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                HorizontalAlignment="Left"
                Command="{Binding TestConnectionCommand}"
                Content="설정 적용 후 연결 테스트" />

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11.5"
                Text="{Binding StatusText}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Failure">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="94"
                Margin="0,0,8,0"
                Content="취소"
                IsCancel="True" />
            <Button
                Width="94"
                Command="{Binding SaveCommand}"
                Content="저장"
                IsDefault="True"
                Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
